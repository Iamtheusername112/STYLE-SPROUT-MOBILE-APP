EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Clerk Billing — create a user plan in Dashboard → Billing → Subscription plans
EXPO_PUBLIC_CLERK_PREMIUM_PLAN_ID=cplan_your_plan_id_here
# Plan slug for auth.has({ plan }) — must match the slug in Clerk Dashboard
EXPO_PUBLIC_CLERK_PREMIUM_PLAN_SLUG=premium
# Optional feature slug for auth.has({ feature })
EXPO_PUBLIC_CLERK_PREMIUM_FEATURE_SLUG=unlimited_saves
